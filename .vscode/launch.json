{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug terminal (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/skylit_server",
      "args": ["--host", "127.0.0.1", "--port", "8080", "--web-root", "${workspaceFolder}/frontend"],
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build (debug)",
      "setupCommands": [
        { "description": "Pretty-print STL", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Run terminal (release, no debugger)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/skylit_server",
      "args": ["--host", "127.0.0.1", "--port", "8080", "--web-root", "${workspaceFolder}/frontend"],
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build (release)"
    },
    {
      "name": "Debug engine unit tests (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/projection_test",
      "args": [],
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build unit tests (debug)"
    }
  ]
}
