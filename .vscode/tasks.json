{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (release)",
      "type": "shell",
      "command": "make build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "build (debug)",
      "type": "shell",
      "command": "make debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "build unit tests (debug)",
      "type": "shell",
      "command": "mkdir -p build/debug && g++ -std=c++23 -Wall -Wextra -Wpedantic -O0 -g3 -Ibackend/include tests/backend/projection_test.cpp -o build/debug/projection_test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "run terminal (127.0.0.1:8080)",
      "type": "shell",
      "command": "bash scripts/run.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "build (release)"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "skylit",
        "pattern": {
          "regexp": "^\\[skylit\\] fatal: (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[run\\] Starting",
          "endsPattern": "^\\[skylit\\] listening on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "test: unit + smoke",
      "type": "shell",
      "command": "make test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "test: browser (Playwright)",
      "type": "shell",
      "command": "make test-e2e",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test: sanitizers (ASan/UBSan/TSan)",
      "type": "shell",
      "command": "make test-sanitize",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "test: backend math golden check",
      "type": "shell",
      "command": "make golden",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
